# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Secret API key from ElevenLabs (https://elevenlabs.io) for realistic AI voice generation.
# Configure this in the AI Studio Settings / Secrets panel.
ELEVENLABS_API_KEY=""

# ELEVENLABS_VOICE_ID: Optional default voice ID (e.g. 21m00Tcm4TlvDq8ikWAM for Rachel - Professional HR).
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# PLIVO_AUTH_ID: Plivo account Auth ID for placing automated voice agent calls
PLIVO_AUTH_ID=""

# PLIVO_AUTH_TOKEN: Plivo Auth Token
PLIVO_AUTH_TOKEN=""

# PLIVO_PHONE_NUMBER: Virtual Caller ID phone number purchased from Plivo (e.g. +919876543210)
PLIVO_PHONE_NUMBER="+919876543210"

# LIVEKIT_URL: WebSocket URL for LiveKit Real-time Voice Agent (e.g. wss://livekit.company.com)
LIVEKIT_URL=""

# LIVEKIT_API_KEY: LiveKit API Key for real-time voice agent room tokens
LIVEKIT_API_KEY=""

# LIVEKIT_API_SECRET: LiveKit API Secret
LIVEKIT_API_SECRET=""

# META_WA_PHONE_NUMBER_ID: Meta Official WhatsApp Cloud API Phone Number ID
META_WA_PHONE_NUMBER_ID=""

# META_WA_BUSINESS_ACCOUNT_ID: Meta WhatsApp Business Account ID (WABA ID)
META_WA_BUSINESS_ACCOUNT_ID=""

# META_WA_ACCESS_TOKEN: Meta System User Permanent Access Token
META_WA_ACCESS_TOKEN=""

# HRMS_API_BASE_URL: HRMS System REST API endpoint (e.g. https://hrms.company.com/api/v1)
HRMS_API_BASE_URL="https://hrms.talentcarriage.com/api/v2"

# HRMS_API_TOKEN: HRMS Bearer Token for fetching biometric punches & sync
HRMS_API_TOKEN=""

# OPENAI_API_KEY: Optional key if admin chooses OpenAI models (e.g. GPT-4o)
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Optional key if admin chooses Anthropic models (e.g. Claude 3.5)
ANTHROPIC_API_KEY=""

# DEEPSEEK_API_KEY: Optional key if admin chooses DeepSeek models (e.g. DeepSeek V3)
DEEPSEEK_API_KEY=""

